HALMINI_DB=data/amy.db
HALMINI_MAX_DEPTH=16
HALMINI_INFERENCE_BUDGET=5000

# --- Discord (python -m interfaces.discord_bot) ---------------------------------
# Bot token from https://discord.com/developers/applications. Enable the MESSAGE CONTENT
# and SERVER MEMBERS privileged intents for the bot. Never commit the real token.
DISCORD_TOKEN=
HALMINI_NAME=Amy
HALMINI_PREFIX=!
# Channel ids where it answers every message without being @mentioned (comma separated).
HALMINI_TEXT_CHANNELS=

# --- Listening ------------------------------------------------------------------
# wake   = hears everything, answers only when its name is said (or right after it answered you)
# always = answers everything it hears
HALMINI_LISTEN_MODE=wake
# Extra sound-alikes Whisper may produce for the name (Adam's defaults: adams,addam,adem,adum)
HALMINI_WAKE_WORDS=amy,aimee,amie,aymee
HALMINI_FOLLOW_UP_SECONDS=8
# Learn facts from conversation not addressed to it (always remembered as history either way)
HALMINI_LEARN_OVERHEARD=false
HALMINI_LISTEN_TO_BOTS=true
# false = he always finishes speaking and replies queue up. true = talking over him cuts him off.
HALMINI_BARGE_IN=false
HALMINI_SILENCE_MS=900
HALMINI_MIN_UTTERANCE_MS=400
HALMINI_MAX_UTTERANCE_MS=15000

# --- Speech models (local) -------------------------------------------------------
# tiny.en / base.en / small.en / medium.en ; device cpu, cuda or auto
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
# Text-to-speech: fish (default, cloud), piper (local), or none (text replies only)
TTS_ENGINE=fish
# Fish Audio API key from fish.audio (API keys page). Only reply text is sent to Fish Audio.
FISH_API_KEY=
# Models: s2.1-pro-free (free tier), s2.1-pro, s2-pro, s1, drama-3
# Reference id of the voice model to speak with (from its fish.audio page). Empty = default voice.
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
FISH_EXPRESSION_ENABLED=true
# 0 = restrained, 1 = normal range, 1.5 = stronger variation.
FISH_EXPRESSION_STRENGTH=1.0
# Contextual laughter, chuckles, breaths, sighs and yawns, with cooldowns.
FISH_VOCAL_EFFECTS=true
# normal = best quality, balanced = lower latency
FISH_LATENCY=normal
# Only used when TTS_ENGINE=piper: a voice .onnx with its .onnx.json beside it
PIPER_VOICE=

HALMINI_DASHBOARD_PORT=8766

HALMINI_WORDNET_DB=data/wordnet/wordnet.db
