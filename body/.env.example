# ---- Discord (https://discord.com/developers/applications -> your app) ----
DISCORD_TOKEN=
CLIENT_ID=
# Optional: a test server ID. Commands register there instantly; leave blank to register globally.
GUILD_ID=

# ---- Companion ----
BOT_NAME=
# Channel IDs (comma-separated) where the bot replies to every message. It always answers DMs and @mentions.
CHAT_CHANNEL_IDS=
# How many recent messages per conversation he sees with each reply. Also editable in the dashboard.
HISTORY_LIMIT=

# ---- Brain: local Ollama ----
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
# Context window (tokens). Ollama defaults to 4096, too small for 100 messages of history.
OLLAMA_NUM_CTX=

# ---- Voice: Fish Audio (https://fish.audio -> API keys) ----
FISH_API_KEY=
# Voice model ID from fish.audio (leave blank for default voice)
FISH_VOICE_ID=
FISH_TTS_MODEL=
FISH_LANGUAGE=

# ---- Speech-to-text ----
# groq = Groq cloud Whisper (fast, accurate, free tier; falls back to local if the key is blank or a request fails)
# local = free Whisper on this PC (GPU if available). fish = Fish Audio API (needs API credit).

STT_PROVIDER=
# Groq API key from https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
GROQ_STT_MODEL=
WHISPER_MODEL=
# auto = GPU via DirectML, falls back to CPU. Or force dml / cpu.
WHISPER_DEVICE=
# Voice channel IDs (comma-separated) that /join may use. Empty = any. Also editable in the dashboard.
VOICE_CHANNEL_IDS=

# ---- Dashboard ----
DASHBOARD_PORT=
# Keep 127.0.0.1 so only this PC can open it. If you change it to 0.0.0.0, set a password.
DASHBOARD_HOST=
DASHBOARD_PASSWORD=

# ---- Persona ----
# Let friends change the bot's personality/name just by asking it in chat or voice
PERSONA_SELF_EDIT=
# Your Discord user ID(s). The owner has full access and is the only one who can set contacts'
# tiers (stranger / guest / friend), just by telling the bot, e.g. "make Sam a friend".
OWNER_IDS=

# ---- Web search: Tavily (https://app.tavily.com -> API key, starts with tvly-) ----
# Leave blank to turn search off. Free plan = 1000 searches/month.
TAVILY_API_KEY=
# basic = 1 credit per search, advanced = 2 (better results)
TAVILY_DEPTH=
TAVILY_MAX_RESULTS=

# 3D avatar for /avatar.html (blank = data\avatar.glb)
AVATAR_PATH=

# ---- OpenRouter (https://openrouter.ai/keys, starts with sk-or-) ----
# Cloud models for replies (including big reasoning models) and image generation.
OPENROUTER_API_KEY=
# Which brain writes replies: ollama (local), mistral, openrouter or chatgpt. Also switchable in the dashboard.
BRAIN=
OPENROUTER_MODEL=
# How hard reasoning models think: none, low, medium or high
OPENROUTER_REASONING=
OPENROUTER_IMAGE_MODEL=

# ---- Mistral (https://console.mistral.ai/api-keys) ----
# Mistral's own cloud. The free Experiment plan works; set BRAIN=mistral (or pick it in the dashboard).
MISTRAL_API_KEY=
MISTRAL_MODEL=

# ---- Video replies ----
# With the recorder page open (dashboard > Recorder, keep it open and not minimised), Discord
# text replies also get a clip of her face saying them. Set to off to disable.
AVATAR_VIDEO=

# The other AI companion(s) she listens to and talks with (Discord user ID or name).
PEER_BOTS=
PEER_APPS=
PEER_UNLIMITED=

HF_TOKEN=
VOICE_FREE_TALK=

# The owner's desktop/stream account (Amy Smith): not a person in the call, never spoken to.
OWNER_ALT_ACCOUNT_IDS=
PHONE_PORT=
